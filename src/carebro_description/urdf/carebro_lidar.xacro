<?xml version="1.0"?>
<!-- 2D LiDAR mounted on top of base_link. Publishes sensor_msgs/LaserScan on /scan
     (bridged by carebro_gazebo/launch/sim.launch.py). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="carebro">

    <link name="lidar_link">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.03"/>
            </geometry>
            <material name="lidar_black">
                <color rgba="0.05 0.05 0.05 1.0"/>
            </material>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="1.156e-05" ixy="0.0" ixz="0.0"
                     iyy="1.156e-05" iyz="0.0"
                     izz="1.5625e-05"/>
        </inertial>
    </link>

    <!-- base_link top is at z = 0.079; the lidar sits just above it -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin rpy="0 0 0" xyz="0 0 0.10"/>
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="lidar" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <xacro:if value="$(arg is_ignition)">
                <ignition_frame_id>lidar_link</ignition_frame_id>
            </xacro:if>
            <xacro:unless value="$(arg is_ignition)">
                <gz_frame_id>lidar_link</gz_frame_id>
            </xacro:unless>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>8.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>
</robot>
